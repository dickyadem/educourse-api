// ============================================================
// Konfigurasi database (Langkah 1)
// Salin file ini menjadi .env lalu sesuaikan dengan mesinmu.
// Password default XAMPP kosong, jadi DB_PASSWORD dibiarkan kosong.
// ============================================================

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=educourse

# Port untuk aplikasi Node.js
APP_PORT=3000
